{"cells":[{"cell_type":"markdown","metadata":{"id":"UE9dlMILD8lX"},"source":["# VISIONPORT - Traffic Monitoring"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"SkegcTU6D8lZ","colab":{"base_uri":"https://localhost:8080/"},"outputId":"365d6e02-c16e-4127-db66-358ada992ee8"},"outputs":[],"source":["# ================================================================\n","# TASK 1: Install Python, OpenCV and required libraries\n","# Expected output: Working Python environment\n","# ================================================================\n","\n","!pip install -q ultralytics opencv-python matplotlib pandas==2.2.3\n","\n","import os\n","import math\n","import cv2\n","import torch\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from collections import Counter, defaultdict\n","from ultralytics import YOLO\n","from google.colab import files\n","from IPython.display import display, Video\n","\n","print(\"VISIONPORT INITIALIZING...\")\n","\n","# ---- Environment check ----\n","print(\"\\nSYSTEM INFORMATION\")\n","print(\"OpenCV:\", cv2.__version__)\n","print(\"PyTorch:\", torch.__version__)\n","print(\"CUDA:\", torch.cuda.is_available())\n","\n","if torch.cuda.is_available():\n","    DEVICE = 0\n","    print(\"GPU:\", torch.cuda.get_device_name(0))\n","else:\n","    DEVICE = \"cpu\"\n","    print(\"GPU: Not available. Using CPU instead.\")\n","\n","# ---- Configuration (used by the later tasks) ----\n","# Adjust these according to your video.\n","CONFIDENCE = 0.25\n","IMAGE_SIZE = 960\n","\n","# Task 13 - speed: set after calibrating the camera (e.g. 20 pixels = 1 meter).\n","PIXELS_PER_METER = None\n","\n","# Task 16 - entry / exit lines (fraction of the frame height).\n","ENTRY_LINE_RATIO = 0.25\n","EXIT_LINE_RATIO = 0.75\n","\n","# Task 18 - expected traffic direction: \"down\" or \"up\".\n","EXPECTED_DIRECTION = \"down\"\n","\n","# Task 19 - restricted parking zone as polygon points in percent of the frame.\n","# Example: [(10, 60), (40, 60), (40, 90), (10, 90)]. Empty list = not configured.\n","RESTRICTED_ZONE = []\n","PARKING_THRESHOLD = 10          # seconds\n","\n","# Tasks 10-11 - traffic density thresholds (vehicles per frame).\n","LOW_TRAFFIC = 5\n","HIGH_TRAFFIC = 15\n","\n","# Output folders\n","FRAMES_DIR = \"/content/VISIONPORT_Frames\"\n","RESULTS_DIR = \"/content/VISIONPORT_Results\"\n","os.makedirs(FRAMES_DIR, exist_ok=True)\n","os.makedirs(RESULTS_DIR, exist_ok=True)\n","\n","print(\"\\nTask 1 complete: environment ready.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"XQXZsM1sD8la","colab":{"base_uri":"https://localhost:8080/","height":108},"outputId":"34af25de-3533-4ae6-9d9e-2446faf975e2"},"outputs":[],"source":["# ================================================================\n","# TASK 2: Capture an image of a traffic signal using a camera\n","# Expected output: Traffic image capture\n","# ================================================================\n","# Take a photo of a traffic signal with your camera / phone and upload it here.\n","\n","print(\"UPLOAD A TRAFFIC SIGNAL IMAGE\")\n","\n","uploaded_image = files.upload()\n","\n","if not uploaded_image:\n","    raise ValueError(\"Please upload a traffic image.\")\n","\n","image_path = next(iter(uploaded_image))\n","\n","print(\"Image captured:\", image_path)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"0JSiY_L5D8la","colab":{"base_uri":"https://localhost:8080/","height":704},"outputId":"3fbf38dc-bbd5-4a81-c017-843c9439830c"},"outputs":[],"source":["# ================================================================\n","# TASK 3: Read and display traffic images using OpenCV\n","# Expected output: Image display window\n","# ================================================================\n","\n","image = cv2.imread(image_path)\n","\n","if image is None:\n","    raise ValueError(\"Invalid image.\")\n","\n","height, width = image.shape[:2]\n","\n","print(\"Image:\", image_path)\n","print(\"Resolution:\", width, \"x\", height)\n","\n","plt.figure(figsize=(14, 8))\n","plt.imshow(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))\n","plt.title(\"VISIONPORT - Traffic Image\")\n","plt.axis(\"off\")\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":212},"id":"vwD1t-PkD8lb","outputId":"f76f179b-865a-4c60-9410-f75e162fe468"},"outputs":[],"source":["# ================================================================\n","# TASK 4: Load and play a traffic video using OpenCV\n","# Expected output: Video playback\n","# ================================================================\n","\n","print(\"UPLOAD A TRAFFIC VIDEO (used for Tasks 4-20)\")\n","\n","uploaded_video = files.upload()\n","\n","if not uploaded_video:\n","    raise ValueError(\"Please upload a traffic video.\")\n","\n","video_path = next(iter(uploaded_video))\n","\n","cap = cv2.VideoCapture(video_path)\n","\n","if not cap.isOpened():\n","    raise ValueError(\"Unable to open video.\")\n","\n","fps = cap.get(cv2.CAP_PROP_FPS)\n","\n","if not np.isfinite(fps) or fps <= 0:\n","    fps = 25.0\n","\n","video_width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n","video_height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n","total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","\n","cap.release()\n","\n","print(\"\\nVIDEO INFORMATION\")\n","print(\"Width:\", video_width)\n","print(\"Height:\", video_height)\n","print(\"FPS:\", fps)\n","print(\"Total Frames:\", total_frames)\n","print(\"Duration:\", round(total_frames / fps, 2), \"seconds\")\n","\n","\n","# ---- Helpers reused by the later tasks ----\n","def read_frames(path):\n","    \"\"\"Yield (frame_number, frame) for every frame; numbering starts at 1.\"\"\"\n","    reader = cv2.VideoCapture(path)\n","    n = 0\n","    while True:\n","        ret, frame = reader.read()\n","        if not ret:\n","            break\n","        n += 1\n","        yield n, frame\n","    reader.release()\n","\n","\n","def get_frame(path, n):\n","    \"\"\"Return frame number n (1-based) or None.\"\"\"\n","    reader = cv2.VideoCapture(path)\n","    reader.set(cv2.CAP_PROP_POS_FRAMES, n - 1)\n","    ret, frame = reader.read()\n","    reader.release()\n","    return frame if ret else None\n","\n","\n","# ---- Play the video ----\n","display(Video(video_path, embed=True, width=640))"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"OYt5wTWVD8lb","colab":{"base_uri":"https://localhost:8080/","height":286},"outputId":"dccbac63-781a-45db-d4f3-f8598d7ed237"},"outputs":[],"source":["# ================================================================\n","# TASK 5: Extract individual frames from traffic videos\n","# Expected output: Frames saved as images\n","# ================================================================\n","# Saves one frame per second for the first 10 seconds.\n","\n","step = max(1, int(fps))\n","saved_frames = []\n","\n","for n, frame in read_frames(video_path):\n","\n","    if n > fps * 10:\n","        break\n","\n","    if n % step == 0:\n","        file_name = os.path.join(FRAMES_DIR, f\"frame_{n}.jpg\")\n","        cv2.imwrite(file_name, frame)\n","        saved_frames.append(file_name)\n","\n","print(\"Frames Extracted:\", len(saved_frames))\n","print(\"Saved in:\", FRAMES_DIR)\n","\n","# Preview up to 3 extracted frames\n","if saved_frames:\n","    preview = saved_frames[:3]\n","    plt.figure(figsize=(15, 5))\n","    for i, file_name in enumerate(preview):\n","        plt.subplot(1, len(preview), i + 1)\n","        plt.imshow(cv2.cvtColor(cv2.imread(file_name), cv2.COLOR_BGR2RGB))\n","        plt.title(os.path.basename(file_name))\n","        plt.axis(\"off\")\n","    plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Ri2PW5NtD8lb","colab":{"base_uri":"https://localhost:8080/","height":1000},"outputId":"ecee6ee8-f632-4134-9eaa-b3a99bc17265"},"outputs":[],"source":["# ================================================================\n","# TASK 6: Detect cars in a traffic video using YOLO\n","# Expected output: Car detection with bounding boxes\n","# ================================================================\n","\n","print(\"\\nLoading YOLO11 Nano...\")\n","\n","model = YOLO(\"yolo11n.pt\")\n","\n","print(\"Model Loaded Successfully!\")\n","\n","# COCO classes\n","PERSON = 0\n","BICYCLE = 1\n","CAR = 2\n","MOTORCYCLE = 3\n","BUS = 5\n","TRAIN = 6\n","TRUCK = 7\n","TRAFFIC_LIGHT = 9\n","\n","VEHICLE_CLASSES = [BICYCLE, CAR, MOTORCYCLE, BUS, TRAIN, TRUCK]\n","\n","VEHICLE_NAMES = {\n","    BICYCLE: \"Bicycle\",\n","    CAR: \"Car\",\n","    MOTORCYCLE: \"Motorcycle\",\n","    BUS: \"Bus\",\n","    TRAIN: \"Train\",\n","    TRUCK: \"Truck\"\n","}\n","\n","\n","def get_center(box):\n","    x1, y1, x2, y2 = box\n","    return (int((x1 + x2) / 2), int((y1 + y2) / 2))\n","\n","\n","def draw_detections(frame, dets, class_ids, show_conf=False, show_id=False):\n","    \"\"\"Draw boxes + names for the detections whose class is in class_ids.\"\"\"\n","    out = frame.copy()\n","    for d in dets:\n","        if d[\"cls\"] not in class_ids:\n","            continue\n","        x1, y1, x2, y2 = d[\"box\"]\n","        label = VEHICLE_NAMES.get(d[\"cls\"], d[\"name\"])\n","        if show_id and d[\"id\"] is not None:\n","            label += f\" ID:{d['id']}\"\n","        if show_conf:\n","            label += f\" {d['conf']:.2f}\"\n","        cv2.rectangle(out, (x1, y1), (x2, y2), (0, 255, 0), 2)\n","        cv2.putText(out, label, (x1, max(20, y1 - 8)),\n","                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 0), 2)\n","    return out\n","\n","\n","def show_frame(img, title):\n","    plt.figure(figsize=(16, 10))\n","    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n","    plt.title(title)\n","    plt.axis(\"off\")\n","    plt.show()\n","\n","\n","# ---- Detection on the still image from Task 2 ----\n","image_result = model.predict(\n","    source=image,\n","    imgsz=640,\n","    conf=0.15, # Lowered threshold for maximum recall\n","    device=DEVICE,\n","    max_det=1000,\n","    verbose=False\n",")[0]\n","\n","print(\"\\nIMAGE DETECTION REPORT\")\n","for name, count in Counter(\n","    model.names[int(box.cls[0])] for box in image_result.boxes\n",").items():\n","    print(name, \":\", count)\n","print(\"Total Objects:\", len(image_result.boxes))\n","\n","show_frame(image_result.plot(), \"VISIONPORT Image Detection\")\n","\n","# ---- Detection + tracking on the whole video (Optimized) ----\n","print(\"\\nVISIONPORT VIDEO ANALYSIS STARTED\")\n","\n","frame_data = []     # one entry per frame: {\"frame\", \"time\", \"dets\": [...]}\n","\n","# Disable frame skipping to track vehicles continuously across every frame\n","skip_step = 1\n","last_dets = []\n","\n","for n, frame in read_frames(video_path):\n","    if n > 1000:\n","        break\n","\n","    if n % skip_step == 1 or skip_step == 1:\n","        result = model.track(\n","            source=frame,\n","            persist=True,\n","            tracker=\"bytetrack.yaml\",\n","            imgsz=640,\n","            conf=0.15,  # Lowered confidence threshold for maximum sensitivity\n","            classes=[PERSON] + VEHICLE_CLASSES + [TRAFFIC_LIGHT],\n","            device=DEVICE,\n","            max_det=100,\n","            verbose=False\n","        )[0]\n","\n","        dets = []\n","        if result.boxes is not None and len(result.boxes) > 0:\n","            for box in result.boxes:\n","                class_id = int(box.cls[0])\n","                x1, y1, x2, y2 = map(int, box.xyxy[0].tolist())\n","                dets.append({\n","                    \"cls\": class_id,\n","                    \"name\": model.names[class_id],\n","                    \"conf\": float(box.conf[0]),\n","                    \"box\": (x1, y1, x2, y2),\n","                    \"center\": get_center((x1, y1, x2, y2)),\n","                    \"id\": int(box.id[0]) if box.id is not None else None\n","                })\n","        last_dets = dets\n","    else:\n","        dets = last_dets\n","\n","    frame_data.append({\"frame\": n, \"time\": n / fps, \"dets\": dets})\n","\n","    if n % 100 == 0:\n","        print(f\"Processed {n} frames\")\n","\n","print(\"\\nVIDEO ANALYSIS COMPLETED!\")\n","\n","# ---- Task 6 output: cars ----\n","cars_per_frame = [\n","    sum(1 for d in f[\"dets\"] if d[\"cls\"] == CAR) for f in frame_data\n","]\n","\n","print(\"\\nCAR DETECTION REPORT\")\n","print(\"Frames processed:\", len(frame_data))\n","print(\"Total car detections:\", sum(cars_per_frame))\n","print(\"Max cars in one frame:\", max(cars_per_frame, default=0))\n","\n","best_n = int(np.argmax(cars_per_frame)) + 1\n","sample = get_frame(video_path, best_n)\n","\n","if sample is not None:\n","    show_frame(\n","        draw_detections(sample, frame_data[best_n - 1][\"dets\"], [CAR]),\n","        f\"TASK 6 - Car detection (frame {best_n})\"\n","    )"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"d-w_cSe8D8lc","colab":{"base_uri":"https://localhost:8080/","height":843},"outputId":"16bdf11c-b585-46a4-ccb4-2065ba329a4d"},"outputs":[],"source":["# ================================================================\n","# TASK 7: Detect bikes, buses and trucks\n","# Expected output: Multiple vehicle detection\n","# ================================================================\n","\n","BIKE_BUS_TRUCK = [BICYCLE, MOTORCYCLE, BUS, TRUCK]\n","\n","detections_per_class = Counter(\n","    VEHICLE_NAMES[d[\"cls\"]]\n","    for f in frame_data\n","    for d in f[\"dets\"]\n","    if d[\"cls\"] in BIKE_BUS_TRUCK\n",")\n","\n","print(\"BIKE / BUS / TRUCK DETECTION REPORT\")\n","for name in [\"Bicycle\", \"Motorcycle\", \"Bus\", \"Truck\"]:\n","    print(name, \":\", detections_per_class.get(name, 0), \"detections\")\n","\n","counts_per_frame = [\n","    sum(1 for d in f[\"dets\"] if d[\"cls\"] in BIKE_BUS_TRUCK) for f in frame_data\n","]\n","\n","best_n = int(np.argmax(counts_per_frame)) + 1\n","sample = get_frame(video_path, best_n)\n","\n","if sample is not None:\n","    show_frame(\n","        draw_detections(sample, frame_data[best_n - 1][\"dets\"], BIKE_BUS_TRUCK),\n","        f\"TASK 7 - Bikes, buses and trucks (frame {best_n})\"\n","    )"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"zqNRHF0KD8ld","colab":{"base_uri":"https://localhost:8080/","height":1000},"outputId":"0be56a45-04f2-4545-c3b4-d16249f2ed36"},"outputs":[],"source":["# ================================================================\n","# TASK 8: Display vehicle names and confidence scores\n","# Expected output: Labelled detection output\n","# ================================================================\n","\n","vehicles_per_frame_all = [\n","    sum(1 for d in f[\"dets\"] if d[\"cls\"] in VEHICLE_CLASSES) for f in frame_data\n","]\n","\n","best_n = int(np.argmax(vehicles_per_frame_all)) + 1\n","best_dets = frame_data[best_n - 1][\"dets\"]\n","\n","print(f\"LABELLED DETECTIONS (frame {best_n})\")\n","\n","for d in sorted(best_dets, key=lambda d: -d[\"conf\"]):\n","    if d[\"cls\"] in VEHICLE_CLASSES:\n","        print(f\"{VEHICLE_NAMES[d['cls']]:<11} ID:{str(d['id']):<5} \"\n","              f\"confidence: {d['conf']:.2f}\")\n","\n","sample = get_frame(video_path, best_n)\n","\n","if sample is not None:\n","    show_frame(\n","        draw_detections(sample, best_dets, VEHICLE_CLASSES,\n","                        show_conf=True, show_id=True),\n","        f\"TASK 8 - Vehicle names and confidence scores (frame {best_n})\"\n","    )"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"F80FfKz9D8ld","colab":{"base_uri":"https://localhost:8080/"},"outputId":"f90de561-fa27-4582-a72d-7b73e4bbc992"},"outputs":[],"source":["# ================================================================\n","# TASK 9: Count the number of vehicles in a video frame\n","# Expected output: Vehicle count\n","# ================================================================\n","\n","frame_vehicle_counts = [\n","    sum(1 for d in f[\"dets\"] if d[\"cls\"] in VEHICLE_CLASSES) for f in frame_data\n","]\n","\n","print(\"VEHICLE COUNT PER FRAME\")\n","print(\"First 10 frames:\", frame_vehicle_counts[:10])\n","print(\"Average vehicles per frame:\", round(float(np.mean(frame_vehicle_counts)), 2))\n","print(\"Maximum in a frame:\", max(frame_vehicle_counts, default=0))\n","print(\"Minimum in a frame:\", min(frame_vehicle_counts, default=0))"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"N_9lxuOUD8ld","colab":{"base_uri":"https://localhost:8080/"},"outputId":"f09ed691-7693-4d0d-d066-9a008f1a4507"},"outputs":[],"source":["# ================================================================\n","# TASK 10: Calculate traffic density based on vehicle count\n","# Expected output: Low, medium and high traffic\n","# ================================================================\n","\n","\n","def get_density(vehicle_count):\n","    if vehicle_count <= LOW_TRAFFIC:\n","        return \"LOW\"\n","    elif vehicle_count <= HIGH_TRAFFIC:\n","        return \"MEDIUM\"\n","    return \"HIGH\"\n","\n","\n","frame_density_labels = [get_density(c) for c in frame_vehicle_counts]\n","\n","average_vehicles = float(np.mean(frame_vehicle_counts))\n","\n","print(\"TRAFFIC DENSITY REPORT\")\n","print(\"Average Vehicles Per Frame:\", round(average_vehicles, 2))\n","print(\"Overall Traffic Density:\", get_density(average_vehicles))\n","print(\"Frames per level:\", dict(Counter(frame_density_labels)))"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"GX-EiM9HD8ld","colab":{"base_uri":"https://localhost:8080/"},"outputId":"868eda73-6443-4f84-e865-1673737f445f"},"outputs":[],"source":["# ================================================================\n","# TASK 11: Detect traffic congestion at signal junctions\n","# Expected output: Congestion alerts\n","# ================================================================\n","# A frame is congested when its density is HIGH.\n","\n","congestion_frames = sum(1 for d in frame_density_labels if d == \"HIGH\")\n","\n","print(\"TRAFFIC CONGESTION REPORT\")\n","print(\"High-Density Frames:\", congestion_frames)\n","print(\"Congestion Percentage:\",\n","      round(congestion_frames / len(frame_density_labels) * 100, 2), \"%\")\n","\n","# Group consecutive HIGH frames into alerts\n","congestion_alerts = []\n","start = None\n","\n","for i, label in enumerate(frame_density_labels):\n","    if label == \"HIGH\" and start is None:\n","        start = i\n","    elif label != \"HIGH\" and start is not None:\n","        congestion_alerts.append((start, i - 1))\n","        start = None\n","\n","if start is not None:\n","    congestion_alerts.append((start, len(frame_density_labels) - 1))\n","\n","if congestion_alerts:\n","    print(\"\\nCONGESTION ALERTS\")\n","    for s, e in congestion_alerts[:10]:\n","        print(f\"ALERT: congestion from {frame_data[s]['time']:.1f}s \"\n","              f\"to {frame_data[e]['time']:.1f}s\")\n","    if len(congestion_alerts) > 10:\n","        print(f\"... and {len(congestion_alerts) - 10} more\")\n","else:\n","    print(\"No congestion detected.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Ss3a5m6cD8le","colab":{"base_uri":"https://localhost:8080/"},"outputId":"e6e19435-e79c-4ca6-f571-a7fc8b6d2729"},"outputs":[],"source":["# ================================================================\n","# TASK 12: Track individual vehicles across video frames\n","# Expected output: Vehicle tracking IDs\n","# ================================================================\n","# Uses the ByteTrack IDs produced in Task 6.\n","\n","trajectories = defaultdict(list)    # id -> [(x, y, time, frame), ...]\n","vehicle_first_seen = {}\n","vehicle_last_seen = {}\n","vehicle_type = {}\n","\n","for f in frame_data:\n","    for d in f[\"dets\"]:\n","        if d[\"cls\"] in VEHICLE_CLASSES and d[\"id\"] is not None:\n","            tid = d[\"id\"]\n","            if tid not in vehicle_first_seen:\n","                vehicle_first_seen[tid] = f[\"time\"]\n","                vehicle_type[tid] = VEHICLE_NAMES[d[\"cls\"]]\n","            vehicle_last_seen[tid] = f[\"time\"]\n","            trajectories[tid].append(\n","                (d[\"center\"][0], d[\"center\"][1], f[\"time\"], f[\"frame\"])\n","            )\n","\n","vehicle_counts = Counter(vehicle_type.values())\n","\n","print(\"VEHICLE TRACKING REPORT\")\n","print(\"Unique Vehicle IDs:\", len(vehicle_first_seen))\n","\n","print(\"\\nUNIQUE VEHICLES BY TYPE\")\n","for name, count in vehicle_counts.items():\n","    print(name, \":\", count)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"EJmHn42JD8le","colab":{"base_uri":"https://localhost:8080/"},"outputId":"3aa88f14-7be5-4fc6-b63c-2a4a05193038"},"outputs":[],"source":["# ================================================================\n","# TASK 13: Calculate approximate vehicle speed\n","# Expected output: Speed estimation\n","# ================================================================\n","# Needs PIXELS_PER_METER (set in Task 1) from a known real-world distance.\n","\n","vehicle_speeds = {}     # id -> latest speed (km/h)\n","speed_by_frame = {}     # (frame, id) -> speed (km/h)\n","\n","print(\"VEHICLE SPEED REPORT\")\n","\n","if PIXELS_PER_METER is None:\n","    print(\"Speed not calibrated. Set PIXELS_PER_METER \"\n","          \"using a known real-world distance.\")\n","else:\n","    for tid, traj in trajectories.items():\n","        for i in range(1, len(traj)):\n","            x_old, y_old, t_old, _ = traj[i - 1]\n","            x, y, t, frame_no = traj[i]\n","            elapsed = t - t_old\n","            if elapsed > 0:\n","                speed = (math.dist((x, y), (x_old, y_old))\n","                         / PIXELS_PER_METER / elapsed) * 3.6\n","                vehicle_speeds[tid] = round(speed, 2)\n","                speed_by_frame[(frame_no, tid)] = speed\n","\n","    for tid, speed in vehicle_speeds.items():\n","        print(\"Vehicle ID:\", tid, \"Speed:\", speed, \"km/h\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Swm_cJSJD8le","colab":{"base_uri":"https://localhost:8080/"},"outputId":"d6c3587c-0746-42bf-e8f5-09005f3f5916"},"outputs":[],"source":["# ================================================================\n","# TASK 14: Identify traffic signal status (red, yellow, green)\n","# Expected output: Signal status detection\n","# ================================================================\n","\n","\n","def detect_signal_state(frame, box):\n","    \"\"\"Estimate the colour of a detected traffic light using HSV masks.\"\"\"\n","    x1, y1, x2, y2 = map(int, box)\n","\n","    crop = frame[max(0, y1):max(0, y2), max(0, x1):max(0, x2)]\n","\n","    if crop.size == 0:\n","        return \"Unknown\"\n","\n","    hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)\n","\n","    red = cv2.inRange(hsv, np.array([0, 100, 100]), np.array([10, 255, 255]))\n","    red2 = cv2.inRange(hsv, np.array([160, 100, 100]), np.array([180, 255, 255]))\n","    yellow = cv2.inRange(hsv, np.array([15, 100, 100]), np.array([35, 255, 255]))\n","    green = cv2.inRange(hsv, np.array([40, 70, 70]), np.array([90, 255, 255]))\n","\n","    values = {\n","        \"Red\": cv2.countNonZero(red) + cv2.countNonZero(red2),\n","        \"Yellow\": cv2.countNonZero(yellow),\n","        \"Green\": cv2.countNonZero(green)\n","    }\n","\n","    state = max(values, key=values.get)\n","\n","    if values[state] < 3:\n","        return \"Unknown\"\n","\n","    return state\n","\n","\n","signal_status_history = []      # one status per frame\n","signal_labels = {}              # frame -> [(x1, y1, state), ...]\n","\n","for (n, frame), fd in zip(read_frames(video_path), frame_data):\n","\n","    states = []\n","\n","    for d in fd[\"dets\"]:\n","        if d[\"cls\"] == TRAFFIC_LIGHT:\n","            state = detect_signal_state(frame, d[\"box\"])\n","            states.append(state)\n","            signal_labels.setdefault(n, []).append(\n","                (d[\"box\"][0], d[\"box\"][1], state)\n","            )\n","\n","    signal_status_history.append(\n","        Counter(states).most_common(1)[0][0] if states else \"Not Detected\"\n","    )\n","\n","print(\"TRAFFIC SIGNAL REPORT\")\n","print(Counter(signal_status_history))\n","print(\"Note: Signal colour is estimated from detected traffic-light \"\n","      \"image regions and requires validation.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"UcvWDHuzD8le","colab":{"base_uri":"https://localhost:8080/"},"outputId":"67fd3110-a3ba-434e-bdfe-db597c83a9b2"},"outputs":[],"source":["# ================================================================\n","# TASK 15: Estimate traffic waiting time\n","# Expected output: Waiting-time report\n","# ================================================================\n","# Time each tracked vehicle stays visible in the video.\n","\n","waiting_times = {\n","    tid: round(vehicle_last_seen[tid] - vehicle_first_seen[tid], 2)\n","    for tid in vehicle_first_seen\n","}\n","\n","print(\"VEHICLE WAITING / OBSERVATION TIME REPORT\")\n","\n","for tid, seconds in waiting_times.items():\n","    print(\"Vehicle ID:\", tid, \"Observed Duration:\", seconds, \"seconds\")\n","\n","if waiting_times:\n","    print(\"\\nAverage waiting time:\",\n","          round(float(np.mean(list(waiting_times.values()))), 2), \"seconds\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"FdLyG8kRD8le","colab":{"base_uri":"https://localhost:8080/"},"outputId":"8fc3ca16-0aab-4f23-c8a7-2091c80259cb"},"outputs":[],"source":["# ================================================================\n","# TASK 16: Count vehicles entering and leaving a traffic junction\n","# Expected output: Entry and exit vehicle count\n","# ================================================================\n","# Counts a vehicle when its centre crosses the entry / exit line.\n","\n","entry_line = int(video_height * ENTRY_LINE_RATIO)\n","exit_line = int(video_height * EXIT_LINE_RATIO)\n","\n","entry_frames = []\n","exit_frames = []\n","\n","for tid, traj in trajectories.items():\n","    for i in range(1, len(traj)):\n","        previous_y = traj[i - 1][1]\n","        current_y = traj[i][1]\n","        frame_no = traj[i][3]\n","\n","        if previous_y < entry_line <= current_y:\n","            entry_frames.append(frame_no)\n","\n","        if previous_y < exit_line <= current_y:\n","            exit_frames.append(frame_no)\n","\n","entry_count = len(entry_frames)\n","exit_count = len(exit_frames)\n","\n","print(\"ENTRY AND EXIT REPORT\")\n","print(\"Entry Crossings:\", entry_count)\n","print(\"Exit Crossings:\", exit_count)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"S4G_w4NZD8le","colab":{"base_uri":"https://localhost:8080/"},"outputId":"aa7c0d7c-4896-46b6-f458-54c5c7f8d77a"},"outputs":[],"source":["# ================================================================\n","# TASK 17: Detect vehicles making wrong turns at intersections\n","# Expected output: Wrong-turn detection\n","# ================================================================\n","# Approximation: flag a vehicle whose path turns by more than 90 degrees\n","# within its last 30 positions.\n","\n","wrong_turn_ids = set()\n","\n","for tid, traj in trajectories.items():\n","    for i in range(len(traj)):\n","        window = traj[max(0, i - 29):i + 1]\n","\n","        if len(window) >= 8:\n","            points = np.array([(p[0], p[1]) for p in window], dtype=float)\n","            vectors = np.diff(points, axis=0)\n","            angles = np.arctan2(vectors[:, 1], vectors[:, 0])\n","            angle_changes = np.diff(angles)\n","            angle_changes = (angle_changes + np.pi) % (2 * np.pi) - np.pi\n","\n","            if abs(np.sum(angle_changes)) > np.pi / 2:\n","                wrong_turn_ids.add(tid)\n","                break\n","\n","print(\"POSSIBLE WRONG TURN REPORT\")\n","print(\"IDs with significant trajectory changes:\", sorted(wrong_turn_ids))"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"1ZV773PdD8lf","colab":{"base_uri":"https://localhost:8080/"},"outputId":"cecdaa6e-db5f-4ee4-ee88-723042afaa13"},"outputs":[],"source":["# ================================================================\n","# TASK 18: Identify vehicles moving in the wrong direction\n","# Expected output: Wrong-way vehicle alerts\n","# ================================================================\n","# A vehicle moving against EXPECTED_DIRECTION by more than 5 px per step.\n","\n","wrong_way_first_frame = {}      # id -> frame where it was first flagged\n","\n","for tid, traj in trajectories.items():\n","    for i in range(1, len(traj)):\n","        displacement = traj[i][1] - traj[i - 1][1]\n","\n","        if ((EXPECTED_DIRECTION == \"down\" and displacement < -5)\n","                or (EXPECTED_DIRECTION == \"up\" and displacement > 5)):\n","            wrong_way_first_frame.setdefault(tid, traj[i][3])\n","\n","wrong_way_ids = set(wrong_way_first_frame)\n","\n","print(\"WRONG WAY REPORT\")\n","print(\"Possible Wrong-Way IDs:\", sorted(wrong_way_ids))\n","\n","for tid in sorted(wrong_way_ids):\n","    print(f\"ALERT: vehicle {tid} ({vehicle_type[tid]}) moving the wrong way \"\n","          f\"at frame {wrong_way_first_frame[tid]}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"0bFywigTD8lf","colab":{"base_uri":"https://localhost:8080/"},"outputId":"4666513c-c606-4ddd-e03f-08e8ce9f74fc"},"outputs":[],"source":["# ================================================================\n","# TASK 19: Detect vehicles parked in restricted traffic areas\n","# Expected output: Illegal parking detection\n","# ================================================================\n","# A vehicle is flagged when it stays almost still inside RESTRICTED_ZONE\n","# for at least PARKING_THRESHOLD seconds.\n","\n","\n","def point_inside_polygon(point, polygon):\n","    if len(polygon) < 3:\n","        return False\n","\n","    return cv2.pointPolygonTest(\n","        np.array(polygon, dtype=np.int32), point, False\n","    ) >= 0\n","\n","\n","RESTRICTED_POLYGON = [\n","    (int(x * video_width / 100), int(y * video_height / 100))\n","    for x, y in RESTRICTED_ZONE\n","]\n","\n","illegal_parking_ids = set()\n","\n","if RESTRICTED_ZONE:\n","    for tid, traj in trajectories.items():\n","        for i in range(len(traj)):\n","            center = (traj[i][0], traj[i][1])\n","\n","            if not point_inside_polygon(center, RESTRICTED_POLYGON):\n","                continue\n","\n","            window = traj[max(0, i - 29):i + 1]\n","\n","            if len(window) >= 5:\n","                stationary = math.dist(center, (window[0][0], window[0][1])) < 10\n","                parked_time = traj[i][2] - vehicle_first_seen[tid]\n","\n","                if stationary and parked_time >= PARKING_THRESHOLD:\n","                    illegal_parking_ids.add(tid)\n","\n","print(\"ILLEGAL PARKING REPORT\")\n","\n","if not RESTRICTED_ZONE:\n","    print(\"Restricted zone not configured.\")\n","else:\n","    print(\"Possible Illegal Parking IDs:\", sorted(illegal_parking_ids))"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"4JAL-5-qD8lf","colab":{"base_uri":"https://localhost:8080/"},"outputId":"90705e32-2710-47ed-fd0b-532ad214dc8f"},"outputs":[],"source":["# ================================================================\n","# TASK 20: Detect two-wheelers carrying more than two persons\n","# Expected output: Triple-riding detection\n","# ================================================================\n","# Approximation: 3 or more person centres on/just above a motorcycle box.\n","\n","triple_riding_per_frame = []\n","triple_riding_boxes = {}        # frame -> [motorcycle boxes]\n","\n","for f in frame_data:\n","\n","    persons = [d[\"center\"] for d in f[\"dets\"] if d[\"cls\"] == PERSON]\n","    count = 0\n","\n","    for d in f[\"dets\"]:\n","        if d[\"cls\"] != MOTORCYCLE:\n","            continue\n","\n","        mx1, my1, mx2, my2 = d[\"box\"]\n","\n","        riders = sum(\n","            1 for pc in persons\n","            if mx1 - 15 <= pc[0] <= mx2 + 15\n","            and my1 - 0.5 * (my2 - my1) <= pc[1] <= my2 + 15\n","        )\n","\n","        if riders >= 3:\n","            count += 1\n","            triple_riding_boxes.setdefault(f[\"frame\"], []).append((mx1, my1, mx2, my2))\n","\n","    triple_riding_per_frame.append(count)\n","\n","print(\"TRIPLE RIDING REPORT\")\n","print(\"Frames with possible triple riding:\",\n","      sum(1 for c in triple_riding_per_frame if c > 0))\n","print(\"Max possible triple-riding events in one frame:\",\n","      max(triple_riding_per_frame, default=0))\n","print(\"Note: This is an approximate person-to-motorcycle association, \"\n","      \"not a validated rider-counting model.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"uj4fO45aD8lf","colab":{"base_uri":"https://localhost:8080/","height":1000},"outputId":"3c7bf7b4-f1b4-41f4-ef3e-17a6466904ff"},"outputs":[],"source":["# ================================================================\n","# FINAL OUTPUT: annotated video, summary tables, graph and CSV reports\n","# Combines the results of Tasks 4-20\n","# ================================================================\n","\n","output_video = os.path.join(RESULTS_DIR, \"Traffic_Analysis.mp4\")\n","\n","writer = cv2.VideoWriter(\n","    output_video,\n","    cv2.VideoWriter_fourcc(*\"mp4v\"),\n","    fps,\n","    (video_width, video_height)\n",")\n","\n","if not writer.isOpened():\n","    raise RuntimeError(\"Unable to create output video.\")\n","\n","entry_by_frame = Counter(entry_frames)\n","exit_by_frame = Counter(exit_frames)\n","wrong_way_by_frame = Counter(wrong_way_first_frame.values())\n","entry_run = exit_run = wrong_way_run = 0\n","\n","for (n, frame), fd in zip(read_frames(video_path), frame_data):\n","\n","    annotated = frame.copy()\n","\n","    entry_run += entry_by_frame.get(n, 0)\n","    exit_run += exit_by_frame.get(n, 0)\n","    wrong_way_run += wrong_way_by_frame.get(n, 0)\n","\n","    if RESTRICTED_POLYGON:\n","        cv2.polylines(annotated, [np.array(RESTRICTED_POLYGON)], True, (255, 0, 255), 2)\n","\n","    for d in fd[\"dets\"]:\n","        x1, y1, x2, y2 = d[\"box\"]\n","\n","        if d[\"cls\"] in VEHICLE_CLASSES:                       # Tasks 6-8, 12, 13\n","            label = VEHICLE_NAMES[d[\"cls\"]]\n","            if d[\"id\"] is not None:\n","                label += f\" ID:{d['id']}\"\n","                if (n, d[\"id\"]) in speed_by_frame:\n","                    label += f\" {speed_by_frame[(n, d['id'])]:.1f} km/h\"\n","            cv2.rectangle(annotated, (x1, y1), (x2, y2), (0, 255, 0), 2)\n","            cv2.putText(annotated, f\"{label} {d['conf']:.2f}\", (x1, max(20, y1 - 8)),\n","                        cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 0), 2)\n","\n","        elif d[\"cls\"] == PERSON:                              # Task 20 (persons)\n","            cv2.rectangle(annotated, (x1, y1), (x2, y2), (255, 100, 0), 2)\n","            cv2.putText(annotated, f\"Person {d['conf']:.2f}\", (x1, max(20, y1 - 8)),\n","                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 100, 0), 2)\n","\n","    for sx, sy, state in signal_labels.get(n, []):            # Task 14\n","        cv2.putText(annotated, \"Signal: \" + state, (sx, max(20, sy - 10)),\n","                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)\n","\n","    for mx1, my1, mx2, my2 in triple_riding_boxes.get(n, []):  # Task 20\n","        cv2.putText(annotated, \"POSSIBLE TRIPLE RIDING\", (mx1, max(20, my1 - 25)),\n","                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)\n","\n","    dashboard = [                                              # Tasks 9-20\n","        \"VISIONPORT TRAFFIC MONITOR\",\n","        f\"Frame: {n}\",\n","        f\"Vehicles: {frame_vehicle_counts[n - 1]}\",\n","        f\"Density: {frame_density_labels[n - 1]}\",\n","        f\"Signal: {signal_status_history[n - 1]}\",\n","        f\"Entry Count: {entry_run}\",\n","        f\"Exit Count: {exit_run}\",\n","        f\"Wrong Way IDs: {wrong_way_run}\",\n","        f\"Possible Triple Riding: {triple_riding_per_frame[n - 1]}\"\n","    ]\n","\n","    for i, text in enumerate(dashboard):\n","        cv2.putText(annotated, text, (15, 30 + i * 25),\n","                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)\n","\n","    writer.write(annotated)\n","\n","writer.release()\n","\n","# ---- Summary table ----\n","summary = pd.DataFrame(\n","    list(vehicle_counts.items()), columns=[\"Vehicle Type\", \"Unique Count\"]\n",")\n","\n","print(\"\\nFINAL VEHICLE SUMMARY\")\n","display(summary)\n","\n","# ---- Traffic density graph ----\n","plt.figure(figsize=(14, 6))\n","plt.plot(frame_vehicle_counts)\n","plt.title(\"VISIONPORT - Traffic Density Over Time\")\n","plt.xlabel(\"Processed Frame\")\n","plt.ylabel(\"Vehicles Per Frame\")\n","plt.grid(True)\n","plt.show()\n","\n","# ---- CSV reports ----\n","summary.to_csv(os.path.join(RESULTS_DIR, \"Vehicle_Counts.csv\"), index=False)\n","\n","pd.DataFrame([\n","    {\n","        \"Vehicle ID\": tid,\n","        \"Vehicle Type\": vehicle_type[tid],\n","        \"First Seen\": vehicle_first_seen[tid],\n","        \"Last Seen\": vehicle_last_seen[tid],\n","        \"Observed Duration\": waiting_times[tid],\n","        \"Speed km/h\": vehicle_speeds.get(tid, \"Not calibrated\")\n","    }\n","    for tid in vehicle_first_seen\n","]).to_csv(os.path.join(RESULTS_DIR, \"Vehicle_Tracking.csv\"), index=False)\n","\n","# ---- Final report ----\n","print(\"\\n\" + \"=\" * 60)\n","print(\"VISIONPORT - ALL 20 TASKS PROCESSED\")\n","print(\"=\" * 60)\n","print(\"Image Detection:\", len(image_result.boxes))\n","print(\"Unique Tracked Vehicles:\", len(vehicle_first_seen))\n","print(\"Entry Count:\", entry_count)\n","print(\"Exit Count:\", exit_count)\n","print(\"Congestion Frames:\", congestion_frames)\n","print(\"Wrong-Way IDs:\", len(wrong_way_ids))\n","print(\"Possible Wrong Turns:\", len(wrong_turn_ids))\n","print(\"Possible Illegal Parking:\", len(illegal_parking_ids))\n","print(\"Output Video:\", output_video)\n","print(\"=\" * 60)\n","\n","# ---- Show and download ----\n","display(Video(output_video, embed=True))\n","\n","files.download(output_video)\n","files.download(os.path.join(RESULTS_DIR, \"Vehicle_Counts.csv\"))\n","files.download(os.path.join(RESULTS_DIR, \"Vehicle_Tracking.csv\"))\n","\n","print(\"\\nVISIONPORT ANALYSIS FINISHED!\")"]}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}
